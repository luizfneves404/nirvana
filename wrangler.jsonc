{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astro",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  // `directory` is deliberately omitted: @cloudflare/vite-plugin fills it in
  // on the generated output wrangler.json, pointing at the client build.
  //
  // Assets are matched before the Worker runs, so /api/* falls through to Hono
  // on its own — no `run_worker_first` needed. SPA routes never invoke the
  // Worker, which also means they are not billed.
  "assets": {
    "not_found_handling": "single-page-application",
  },
  // Binding stays `DB`: worker/index.ts reads c.env.DB and the generated
  // CloudflareBindings interface declares it under that name.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "astro",
      "database_id": "cc562a8f-5a4c-4f35-9825-5a19f51a14cc",
      "migrations_dir": "drizzle/migrations",
    },
  ],
}
