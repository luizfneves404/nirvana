# Used by `vp build --mode capacitor`.
#
# On the web the SPA and the API share an origin, so a relative base works and
# this stays empty. Inside a Capacitor bundle the app is served from
# capacitor://localhost (iOS) or https://localhost (Android) with no Worker on
# that origin, so it needs the absolute deployed URL.
#
# The matching origins are allow-listed for CORS in worker/index.ts.
VITE_API_BASE_URL=https://astro.luizfneves.workers.dev
